        ]),
        (id: "b-misc", shape: Group, label: "bedtime-clipboard, -syntax", children: [
            (shape: Text(at: (1036, 1324), text: "the system clipboard           \ntree-sitter grammars", size: 14)),
        ]),
        (id: "facade", shape: Group, label: "bedtime  (the facade crate)", stroke: Green, children: [
            (shape: Text(at: (1856, 654), text: "the one dependency:             \nevery crate below,\nre-exported by feature\n\nAppPlugins,\nBedtimeWorldExt", size: 14)),
