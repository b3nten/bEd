(
    version: 1,
    elements: [
        (shape: Text(at: (0, -70), text: "bEd and bedtime, as built. Each layer builds on the ones below it.\nGreen: where an app starts. Yellow: opt-in.", size: 16), stroke: Muted),
        (id: "apps", shape: Rectangle(x: 0, y: 0, w: 1700, h: 204), stroke: Muted, dash: Dashed, rounded: true),
        (shape: Text(at: (16, 10), text: "apps: a main and what's only the app's", size: 16), stroke: Muted),
        (id: "bed", shape: Rectangle(x: 0, y: 268, w: 1700, h: 258), stroke: Muted, dash: Dashed, rounded: true),
        (shape: Text(at: (16, 278), text: "bed (the library): bEd as plugins. About 1,000 lines, and 3,100 of visuals.", size: 16), stroke: Muted),
        (id: "plugins", shape: Rectangle(x: 0, y: 590, w: 1700, h: 204), stroke: Muted, dash: Dashed, rounded: true),
        (shape: Text(at: (16, 600), text: "bedtime's plugins: a crate each, and a feature each of `bedtime`", size: 16), stroke: Muted),
        (id: "framework", shape: Rectangle(x: 0, y: 858, w: 1700, h: 312), stroke: Muted, dash: Dashed, rounded: true),
        (shape: Text(at: (16, 868), text: "bedtime-workbench: the framework, in three tiers", size: 16), stroke: Muted),
        (id: "foundations", shape: Rectangle(x: 0, y: 1234, w: 1700, h: 222), stroke: Muted, dash: Dashed, rounded: true),
        (shape: Text(at: (16, 1244), text: "foundations", size: 16), stroke: Muted),
        (id: "app-bed", shape: Group, label: "bed  (src/bed)", stroke: Green, children: [
            (shape: Text(at: (46, 90), text: "main.rs, 17 lines:\nBevy's plugins + BedPlugins\n+ low latency\nassets/: icon, screenshots", size: 14)),
        ]),
        (id: "app-hello", shape: Group, label: "hello  (src/hello)", stroke: Green, children: [
            (shape: Text(at: (342, 90), text: "main.rs, 105 lines:                  \nAppPlugins::new(\"Hello\")\n+ its own CounterPlugin", size: 14)),
        ]),
        (id: "app-engine", shape: Group, label: "an engine on bEd  (later)", stroke: Muted, dash: Dashed, children: [
            (shape: Text(at: (723, 90), text: "BedPlugins + its own plugins;\nthe game runs in the same ECS,\nso it leaves low latency out", size: 14), stroke: Muted),
        ]),
        (id: "lib-plugins", shape: Group, label: "lib.rs", children: [
            (shape: Text(at: (46, 358), text: "BedPlugins: bedtime's plugins,\nlisted in the order of\ntheir menu items", size: 14)),
        ]),
        (id: "lib-app", shape: Group, label: "bEd's app", children: [
            (shape: Text(at: (368, 358), text: "workbench.rs: AppPlugins(\"bEd\"),\n  documents, workspaces\nthemes.rs: 20 themes\nsettings.rs: section order\nworkspace.rs: what layout 1\n  starts with", size: 14)),
        ]),
        (id: "lib-window", shape: Group, label: "its window", children: [
            (shape: Text(at: (706, 358), text: "window.rs: surface options,\n  keys (VS Code's, its own)\ntitlebar.rs: tool buttons", size: 14)),
        ]),
        (id: "lib-glue", shape: Group, label: "glue between plugins", children: [
            (shape: Text(at: (1002, 358), text: "git.rs: a folder or a terminal\n  from the Git panel\nsearch.rs: seeded from\n  the editor's selection\nterminal.rs: +open, +web,\n  terminals carried over\nmascots.rs: +ducky", size: 14)),
        ]),
        (id: "lib-look", shape: Group, label: "its look", children: [
            (shape: Text(at: (1324, 358), text: "visuals/: shader and 3D\n  backdrops, screen effects", size: 14)),
        ]),
        (id: "p-edit", shape: Group, label: "editing", children: [
            (shape: Text(at: (46, 680), text: "code: editor, language servers,\n  structure, TODOs\nmarkdown, datatree, table\ndiagram, sqlite, hex", size: 14)),
        ]),
        (id: "p-media", shape: Group, label: "media", children: [
            (shape: Text(at: (376, 680), text: "image, audio, video\nmodel, font", size: 14)),
        ]),
        (id: "p-tools", shape: Group, label: "tools", children: [
            (shape: Text(at: (604, 680), text: "file-explorer, terminal\ngit, search\nhttp-client, web\nnotes, schedules", size: 14)),
        ]),
        (id: "p-extra", shape: Group, label: "extras", children: [
            (shape: Text(at: (867, 680), text: "cat, frame-rate, mascots", size: 14)),
        ]),
        (id: "p-auto", shape: Group, label: "automation", children: [
            (shape: Text(at: (1138, 680), text: "scripts drive the app:\ntools/bed.py,\ntests/automation", size: 14)),
        ]),
        (id: "f-app", shape: Group, label: "app tier  (always)", stroke: Green, children: [
            (shape: Text(at: (46, 948), text: "AppPlugins::new(name)\nthe window as panels + status bar\nactions, keys, command palette\nmenus, Quit, exit gates\nsettings in layers, their panel\nthemes, fonts\nbackground work, notifications\nfile pickers, add_panel\nlayout slots\nworld.bedtime()", size: 14)),
        ]),
        (id: "f-docs", shape: Group, label: "documents  (feature)", stroke: Yellow, children: [
            (shape: Text(at: (393, 948), text: "DocumentsPlugins\nstore, formats, viewers\nNew, Save, Undo, Redo\nuntitled, Save As\nfile drops\nunsaved prompt, autosave", size: 14)),
        ]),
        (id: "f-ws", shape: Group, label: "workspaces  (feature)", stroke: Yellow, children: [
            (shape: Text(at: (664, 948), text: "WorkspacesPlugin\na folder with its own store\n  and settings layer\nOpen Folder, Open Recent,\n  Close Folder, New Window\nWorkspaces panel", size: 14)),
        ]),
        (id: "b-ui", shape: Group, label: "bedtime-ui", children: [
            (shape: Text(at: (46, 1324), text: "theme, metrics, icons, widgets\nlayouts: areas, tabs, panels\nsurfaces, window chrome\nviewports, backdrops\nlow latency", size: 14)),
        ]),
        (id: "b-persist", shape: Group, label: "bedtime-persistence", children: [
            (shape: Text(at: (368, 1324), text: "stores and backends\nthe world snapshot (Persist)\npersisted resources", size: 14)),
