(
    version: 1,
    elements: [
        (id: "open", shape: Rectangle(x: 0, y: 0, w: 180, h: 80), label: "Open file", fill: Blue, rounded: true),
        (id: "open-to-check", shape: Arrow(from: "open", to: "check", from_side: Right, to_side: Left)),
        (id: "check", shape: Diamond(x: 280, y: -20, w: 160, h: 120), label: "Is it text?", stroke: Yellow, fill: Yellow),
        (id: "yes", shape: Arrow(from: "check", to: "editor", from_side: Right, to_side: Left), label: "yes", stroke: Green),
        (id: "editor", shape: Ellipse(x: 540, y: 0, w: 180, h: 80), label: "Editor", stroke: Green, fill: Green),
        (id: "no", shape: Arrow(from: "check", to: "hex", from_side: Bottom, to_side: Left, via: [(360, 180)]), label: "no", stroke: Red, width: 3),
        (id: "hex", shape: Rectangle(x: 540, y: 140, w: 180, h: 80), label: "Hex viewer", stroke: Red, fill: Red, dash: Dotted),
        (id: "squiggle", shape: Freehand(points: [(40, 150), (52, 138), (66, 134), (80, 140), (92, 154), (104, 168), (118, 174), (132, 170), (144, 158), (156, 146), (170, 140), (184, 146), (196, 160)]), stroke: Magenta, width: 3),
        (id: "caption", shape: Text(at: (40, 190), text: "Drawn by hand,\nin theme colors", size: 16), stroke: Muted),
        (id: "span", shape: Arrow(from: (0, 250), to: (720, 250), start: Arrow), stroke: Accent, dash: Dashed),
    ],
)
