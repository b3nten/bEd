        "C:/Users/%USERNAME%/AppData/Roaming/npm/pyright-langserver"
      ],
      "args": [
        "--stdio"
      ],
      "settings": {
        "python": {
          "analysis": {
            "diagnosticMode": "workspace"
          }
        }
      }
    },
    "gopls": {
      "command": [
        "gopls",
        "/usr/bin/gopls",
        "/usr/local/bin/gopls",
        "/opt/homebrew/bin/gopls",
        "C:/Users/%USERNAME%/go/bin/gopls.exe"
