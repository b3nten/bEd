// Translated from pinned ned resources/windows/ned.rc.in; see NOTICE.
1 ICON "@BED_ICON_PATH@"
1 VERSIONINFO
FILEVERSION @BED_NUMERIC_VERSION@
PRODUCTVERSION @BED_NUMERIC_VERSION@
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "bEd contributors"
            VALUE "FileDescription", "bEd"
            VALUE "FileVersion", "@BED_VERSION@"
            VALUE "InternalName", "bed"
            VALUE "OriginalFilename", "bed.exe"
            VALUE "ProductName", "bEd"
            VALUE "ProductVersion", "@BED_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
